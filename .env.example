# Discordボット(Claude版)の設定。実際の値は .env にコピーして記入する。
# トークンは秘密なので、共有・公開しない。

DISCORD_TOKEN=ここにトークンを貼る
ALLOWED_USER_ID=AUTO

# Claudeを実行する作業ディレクトリ。各Macの絶対パスへ置き換える
CLAUDE_CWD=/absolute/path/to/workspace
# Claude実行体。各Macで `claude` がある絶対パスへ置き換える
CLAUDE_BIN=/absolute/path/to/claude
CLAUDE_TIMEOUT_MS=3600000

# 会話履歴の肥大化を防ぐ自動更新。どちらかへ到達すると次の依頼前に要約する。
CLAUDE_SESSION_MAX_REQUESTS=20
CLAUDE_SESSION_MAX_CONTEXT_TOKENS=80000
CLAUDE_HANDOFF_MAX_CHARS=3000

# Discord画像添付の上限。PNG・JPEG・WebPのみ対応。
DISCORD_IMAGE_MAX_COUNT=4
DISCORD_IMAGE_MAX_BYTES=10485760
DISCORD_IMAGE_TIMEOUT_MS=15000
